.key Switch1/S,Arg1/K,ArgX/M
.bra {
.ket }
; $VER: WHDLoad-Startup 1.0 (26.06.26)    
;
        
c:areweonline
If $RC EQ 0
   IF $IPStack EQ Roadshow
	   SYS:Rexxc/rx SYS:PiStorm/Network/NetworkRoadshow.rexx Action=Disconnect KeepEnvStatus SilentRunning
	ENDIF
   IF $IPStack EQ AmiTCPNG
	   SYS:Rexxc/rx SYS:PiStorm/Network/NetworkAmiTCPNG.rexx Action=Disconnect KeepEnvStatus SilentRunning
	ENDIF	
	IF $IPStack EQ Miami
	   SYS:Rexxc/rx SYS:PiStorm/network/NetworkMiami.rexx Action=Disconnect KeepEnvStatus SilentRunning
   ENDIF
ELSE
;If somehow we are offline but the environment variables are set, then remove them. This prevents the cleanup script bringing the Amiga online when it was offline to start
	Unsetenv ConnectionType
ENDIF


